# ---------- Database ----------
# Inside docker-compose the API talks to the "db" service; from the host use localhost + POSTGRES_HOST_PORT.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5433/opspilot
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
SOAP_HOST_PORT=8001

# ---------- SOAP supplier portal ----------
SOAP_URL=http://localhost:8001/?wsdl

# ---------- LLM ----------
# auto = openai if OPENAI_API_KEY is set, else gemini if GOOGLE_API_KEY is set, else the offline rule-based planner.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (e.g. Ollama at http://localhost:11434/v1)
OPENAI_BASE_URL=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Embeddings ----------
# local = sentence-transformers all-MiniLM-L6-v2 (384 dims, free). openai = text-embedding-3-small (1536 dims).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_TOP_K=4

# ---------- Business rules ----------
PO_AUTO_APPROVAL_LIMIT=10000
